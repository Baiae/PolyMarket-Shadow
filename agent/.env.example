# Poly-Shadow v0.2/v0.3 research stack
# No Polymarket trading credentials are required for this paper-only runtime.

# ── Paper-mode invariant ──────────────────────────────────────────────────────
# The runtime aborts startup if this is false.
PAPER_TRADING=true

# ── Market data ────────────────────────────────────────────────────────────────
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
MARKET_DISCOVERY_LIMIT=50
MARKET_MAX_BOOK_AGE_MS=60000

# ── Paper accounting / risk ───────────────────────────────────────────────────
INITIAL_BANKROLL=1000
DATABASE_PATH=data/poly_shadow.db
MAX_DRAWDOWN_PCT=0.30
MAX_POSITION_PCT=0.05

# ── Forecasting research ──────────────────────────────────────────────────────
# Separate append-only research journal. Provider credentials/endpoints are
# supplied to research runners, never to the paper execution core.
FORECAST_DATABASE_PATH=data/forecasting.db

# ── Executable structural-arbitrage simulation ────────────────────────────────
ARB_MIN_NET_PROFIT=0.01
ARB_MAX_SHARES=50
ARB_SLIPPAGE_RESERVE_PER_SHARE=0

# ── Local control API ──────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_ALLOWED_ORIGINS=[]
# Optional defense-in-depth token for local kill/resume calls.
CONTROL_TOKEN=
